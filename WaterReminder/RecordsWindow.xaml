<Window x:Class="WaterReminder.RecordsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource FluentWindow}" Title="今日饮水记录" Width="432" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Topmost="True">
  <Border Style="{StaticResource WindowCard}">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="24,16,12,8">
        <StackPanel>
          <TextBlock Text="今日记录" Style="{StaticResource Title}" FontSize="18"/>
          <TextBlock x:Name="SummaryText" Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,0"/>
        </StackPanel>
        <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="关闭" Click="Close_Click"/>
      </Grid>

      <Grid Grid.Row="1" MinHeight="208">
      <ListBox x:Name="RecordsList" Style="{StaticResource PlainList}" Margin="16,0,16,8" MaxHeight="360" VerticalAlignment="Top">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid x:Name="row">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource AccentSoft}">
                <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="14" HorizontalAlignment="Center" Foreground="{DynamicResource AccentText}"/>
              </Border>
              <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding AmountDisplay}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
              </StackPanel>
              <StackPanel x:Name="actions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Opacity="0.35">
                <Button Style="{StaticResource IconButton}" Content="&#xE70F;" ToolTip="修改" Click="Edit_Click" Tag="6"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="删除" Click="Delete_Click" Tag="6"/>
              </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter TargetName="actions" Property="Opacity" Value="1"/>
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
        <Image Source="{StaticResource DropImage}" Width="56" Height="56" Opacity="0.55" RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock Text="今天还没有喝水记录" Foreground="{DynamicResource TextPrimary}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,4"/>
        <TextBlock Text="在主窗口点「喝一杯」就会出现在这里" Style="{StaticResource Caption}" FontSize="13" HorizontalAlignment="Center"/>
      </StackPanel>
      </Grid>

      <Border Grid.Row="2" Background="{DynamicResource SurfaceAlt}" CornerRadius="0,0,12,12" Padding="16,12,24,12" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0">
        <Grid>
          <Button x:Name="ClearButton" Style="{StaticResource DangerGhostButton}" HorizontalAlignment="Left" Click="Clear_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="14" Margin="0,1,8,0"/><TextBlock Text="清空今日"/></StackPanel>
          </Button>
          <Button Style="{StaticResource PrimaryButton}" Content="完成" MinWidth="96" HorizontalAlignment="Right" IsDefault="True" IsCancel="True" Click="Close_Click"/>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
