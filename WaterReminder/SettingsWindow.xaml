<Window x:Class="WaterReminder.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:WaterReminder.Controls"
        Style="{StaticResource FluentWindow}" Title="喝水提醒设置" Width="512" SizeToContent="Height"
        WindowStartupLocation="CenterOwner">
  <Border Style="{StaticResource WindowCard}">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

      <!-- Header -->
      <Grid Margin="24,16,12,8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Image Source="{StaticResource DropImage}" Width="40" Height="40" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="IntroText" Text="设置" Style="{StaticResource Title}"/>
          <TextBlock x:Name="SubText" Style="{StaticResource Caption}" FontSize="13" Margin="0,2,0,0" Text="调整目标、提醒时间和启动方式"/>
        </StackPanel>
        <Button Grid.Column="2" Style="{StaticResource CloseButton}" Content="&#xE8BB;" VerticalAlignment="Top" ToolTip="关闭" Click="Cancel_Click"/>
      </Grid>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,8,20,0" Focusable="False">
        <StackPanel Margin="0,0,4,0">
          <!-- Goal -->
          <TextBlock Text="饮水目标" Style="{StaticResource SectionHeader}"/>
          <Border Style="{StaticResource SectionCard}" Padding="16">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="每日目标" FontSize="13" Margin="0,0,0,8"/>
                  <c:Stepper x:Name="GoalStepper" Minimum="100" Maximum="10000" Step="100" Suffix="ml"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="每杯容量" FontSize="13" Margin="0,0,0,8"/>
                  <c:Stepper x:Name="CupStepper" Minimum="50" Maximum="3000" Step="10" Suffix="ml"/>
                </StackPanel>
              </Grid>
              <TextBlock x:Name="GoalError" Style="{StaticResource ErrorText}" Margin="0,8,0,0"/>
              <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE946;" FontSize="13" Foreground="{DynamicResource AccentText}" Margin="0,1,8,0"/>
                <TextBlock x:Name="PlanSummary" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="400"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Schedule -->
          <TextBlock Text="提醒时间" Style="{StaticResource SectionHeader}"/>
          <Border Style="{StaticResource SectionCard}" Padding="16">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="上班时间" FontSize="13" Margin="0,0,0,8"/>
                  <c:Stepper x:Name="StartStepper" IsTime="True" Minimum="0" Maximum="1439" Step="15"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="下班时间" FontSize="13" Margin="0,0,0,8"/>
                  <c:Stepper x:Name="EndStepper" IsTime="True" Minimum="0" Maximum="1439" Step="15"/>
                </StackPanel>
              </Grid>
              <TextBlock x:Name="TimeError" Style="{StaticResource ErrorText}" Margin="0,8,0,0"/>
              <Border Height="1" Background="{DynamicResource Stroke}" Margin="0,16,0,0"/>
              <CheckBox x:Name="LunchBox" Style="{StaticResource ToggleSwitch}" Click="Lunch_Click">
                <StackPanel><TextBlock Text="午休时段" FontSize="13"/><TextBlock Text="午休期间不提醒" Style="{StaticResource Caption}"/></StackPanel>
              </CheckBox>
              <Grid x:Name="LunchGrid">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="午休开始" FontSize="13" Margin="0,0,0,8"/>
                  <c:Stepper x:Name="LunchStartStepper" IsTime="True" Minimum="0" Maximum="1439" Step="15"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="午休结束" FontSize="13" Margin="0,0,0,8"/>
                  <c:Stepper x:Name="LunchEndStepper" IsTime="True" Minimum="0" Maximum="1439" Step="15"/>
                </StackPanel>
              </Grid>
              <TextBlock x:Name="LunchError" Style="{StaticResource ErrorText}" Margin="0,8,0,0"/>
              <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="下班前不喝水" FontSize="13"/>
                  <TextBlock Text="最后一次提醒会尽量远离下班" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
                </StackPanel>
                <c:Stepper x:Name="NoDrinkStepper" Grid.Column="2" Minimum="0" Maximum="240" Step="5" Suffix="分钟"/>
              </Grid>
              <TextBlock x:Name="NoDrinkError" Style="{StaticResource ErrorText}" Margin="0,8,0,0"/>
              <TextBlock Text="提醒日期" FontSize="13" Margin="0,16,0,8"/>
              <UniformGrid x:Name="DaysGrid" Columns="7" Margin="0,0,-6,0">
                <ToggleButton x:Name="Mon" Style="{StaticResource Chip}" Content="一" Margin="0,0,6,0" Click="Day_Click"/>
                <ToggleButton x:Name="Tue" Style="{StaticResource Chip}" Content="二" Margin="0,0,6,0" Click="Day_Click"/>
                <ToggleButton x:Name="Wed" Style="{StaticResource Chip}" Content="三" Margin="0,0,6,0" Click="Day_Click"/>
                <ToggleButton x:Name="Thu" Style="{StaticResource Chip}" Content="四" Margin="0,0,6,0" Click="Day_Click"/>
                <ToggleButton x:Name="Fri" Style="{StaticResource Chip}" Content="五" Margin="0,0,6,0" Click="Day_Click"/>
                <ToggleButton x:Name="Sat" Style="{StaticResource Chip}" Content="六" Margin="0,0,6,0" Click="Day_Click"/>
                <ToggleButton x:Name="Sun" Style="{StaticResource Chip}" Content="日" Margin="0,0,6,0" Click="Day_Click"/>
              </UniformGrid>
              <TextBlock x:Name="DaysError" Style="{StaticResource ErrorText}" Margin="0,8,0,0" Text="至少选择一天。"/>
            </StackPanel>
          </Border>

          <!-- General -->
          <TextBlock Text="通用" Style="{StaticResource SectionHeader}"/>
          <Border Style="{StaticResource SectionCard}" Padding="16,4">
            <StackPanel>
              <CheckBox x:Name="SoundBox" Style="{StaticResource ToggleSwitch}">
                <StackPanel><TextBlock Text="提醒音效" FontSize="13"/><TextBlock Text="提醒时播放一声轻提示音" Style="{StaticResource Caption}"/></StackPanel>
              </CheckBox>
              <Border Height="1" Background="{DynamicResource Stroke}"/>
              <CheckBox x:Name="AutoStartBox" Style="{StaticResource ToggleSwitch}">
                <StackPanel><TextBlock Text="开机自动启动" FontSize="13"/><TextBlock Text="登录 Windows 后在后台运行" Style="{StaticResource Caption}"/></StackPanel>
              </CheckBox>
              <Border Height="1" Background="{DynamicResource Stroke}"/>
              <CheckBox x:Name="FloatingBox" Style="{StaticResource ToggleSwitch}">
                <StackPanel><TextBlock Text="显示桌面悬浮窗" FontSize="13"/><TextBlock Text="关闭后可从系统托盘打开" Style="{StaticResource Caption}"/></StackPanel>
              </CheckBox>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Footer -->
      <Border Grid.Row="2" Background="{DynamicResource SurfaceAlt}" CornerRadius="0,0,12,12" Padding="24,16" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" Content="取消" MinWidth="96" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
          <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Content="保存" MinWidth="112" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
