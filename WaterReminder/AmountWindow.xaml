<Window x:Class="WaterReminder.AmountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:WaterReminder.Controls"
        Style="{StaticResource FluentWindow}" Title="记录饮水" Width="392" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Topmost="True">
  <Border Style="{StaticResource WindowCard}">
    <StackPanel>
      <Grid Margin="24,16,12,0">
        <TextBlock x:Name="TitleText" Text="自定义饮水量" Style="{StaticResource Title}" FontSize="18" VerticalAlignment="Center"/>
        <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" HorizontalAlignment="Right" ToolTip="关闭" Click="Cancel_Click"/>
      </Grid>
      <StackPanel Margin="24,16,24,24">
        <TextBlock Text="饮水量" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
        <c:Stepper x:Name="AmountStepper" Minimum="1" Maximum="3000" Step="50" Suffix="ml"/>
        <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Margin="0,8,0,0" Text="请输入 1–3000 之间的整数。"/>
        <TextBlock Text="快速选择（ml）" Style="{StaticResource SectionHeader}" Margin="0,16,0,8"/>
        <UniformGrid x:Name="QuickPanel" Columns="4" Margin="0,0,-8,0"/>
      </StackPanel>
      <Border Background="{DynamicResource SurfaceAlt}" CornerRadius="0,0,12,12" Padding="24,16" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource SecondaryButton}" Content="取消" MinWidth="96" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
          <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" Content="记录" MinWidth="96" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </Border>
</Window>
