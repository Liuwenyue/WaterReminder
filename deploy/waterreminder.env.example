# Copy to /etc/waterreminder/waterreminder.env on the server and fill in there.
# Never commit the filled file. Leave these empty in git.
WATERREMINDER_API_TOKEN=
WATERREMINDER_PUSHWARD_TOKEN=
WATERREMINDER_DATA_DIR=/var/lib/waterreminder
WATERREMINDER_PORT=8787
# Keep loopback when the Windows client uses an SSH tunnel.
WATERREMINDER_BIND=127.0.0.1
