<Window x:Class="WaterReminder.Client.OwnerPairWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource FluentWindow}" Title="绑定我的微信" Width="392" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Topmost="True">
  <Border Style="{StaticResource WindowCard}">
    <StackPanel Margin="24">
      <TextBlock Text="绑定我的微信" Style="{StaticResource Title}"/>
      <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,12" TextWrapping="Wrap"
                 Text="在你自己的微信小程序里打开「设置 → 关联我的电脑账本」，获取配对码后填在这里。"/>
      <Label Content="8 位配对码" Target="{Binding ElementName=CodeBox}" Padding="0" Margin="0,0,0,6"
             Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold"/>
      <TextBox x:Name="CodeBox" Style="{StaticResource FluentTextBox}" MaxLength="8"
               AutomationProperties.Name="8 位配对码" InputMethod.IsInputMethodEnabled="False" TextChanged="Code_Changed"/>
      <TextBlock x:Name="Feedback" Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap"
                 Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" Content="取消" IsCancel="True"
                MinWidth="76" Margin="0,0,8,0"/>
        <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" Content="确认绑定" MinWidth="96"
                Click="Confirm_Click" IsDefault="True"/>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
