<Window x:Class="WaterReminder.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:WaterReminder.Client.Controls"
        Style="{StaticResource FluentWindow}"
        x:ClassModifier="internal"
        Title="喝水提醒" Width="352" SizeToContent="Height"
        WindowStartupLocation="Manual" Topmost="True" ShowInTaskbar="False">
  <Border x:Name="Card" Style="{StaticResource WindowCard}">
    <Grid>
      <!-- ===== Expanded ===== -->
      <Grid x:Name="ExpandedPanel" Margin="16,12,12,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Image Source="{StaticResource DropImage}" Width="24" Height="24" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
          <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="今日喝水" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock x:Name="DateText" Style="{StaticResource Caption}"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
            <Button Style="{StaticResource IconButton}" Content="&#xE73F;" ToolTip="精简模式" Click="CompactButton_Click"/>
            <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="设置" Click="SettingsButton_Click"/>
            <Button Style="{StaticResource IconButton}" Content="&#xE921;" ToolTip="隐藏到托盘 (Esc)" Click="HideButton_Click"/>
          </StackPanel>
        </Grid>

        <Grid x:Name="RingHost" Grid.Row="1" Width="184" Height="184" Margin="0,16,4,16" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
          <Grid.RenderTransform><ScaleTransform x:Name="RingScale"/></Grid.RenderTransform>
          <c:ProgressRing x:Name="Ring" Thickness="14" TrackBrush="{DynamicResource RingTrack}" FillBrush="{DynamicResource RingFill}"/>
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid HorizontalAlignment="Center" Height="50">
              <Border x:Name="AmountHit" Background="Transparent" Cursor="Hand" CornerRadius="8" Padding="8,0"
                      ToolTip="点击修正今日已喝量" MouseLeftButtonDown="AmountText_MouseDown">
                <Border.Style>
                  <Style TargetType="Border">
                    <Style.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ControlHover}"/></Trigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <TextBlock x:Name="AmountText" Text="0" FontSize="36" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBox x:Name="AmountEditor" Visibility="Collapsed" Width="140" FontSize="36" FontWeight="SemiBold"
                       TextAlignment="Center" VerticalContentAlignment="Center" Padding="0" MaxLength="6"
                       Background="Transparent" Foreground="{DynamicResource TextPrimary}" CaretBrush="{DynamicResource Accent}"
                       BorderBrush="{DynamicResource Accent}" BorderThickness="0,0,0,2" FocusVisualStyle="{x:Null}"
                       InputMethod.IsInputMethodEnabled="False"
                       PreviewKeyDown="AmountEditor_PreviewKeyDown" LostKeyboardFocus="AmountEditor_LostFocus" TextChanged="AmountEditor_TextChanged">
                <TextBox.Template>
                  <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                      <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"/>
                    </Border>
                  </ControlTemplate>
                </TextBox.Template>
              </TextBox>
            </Grid>
            <TextBlock x:Name="GoalText" MaxWidth="150" TextTrimming="CharacterEllipsis" Text="/ 2,000 ml" Style="{StaticResource Caption}" FontSize="13" HorizontalAlignment="Center" Margin="0,-2,0,8"/>
            <Border x:Name="PercentPill" Background="{DynamicResource AccentSoft}" CornerRadius="10" Padding="10,2" HorizontalAlignment="Center">
              <TextBlock x:Name="PercentText" Text="0%" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}"/>
            </Border>
          </StackPanel>
        </Grid>

        <Border x:Name="StatusPill" Grid.Row="2" Background="{DynamicResource SurfaceAlt}" CornerRadius="8" Padding="12,8" Margin="0,0,4,16">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock x:Name="StatusGlyph" Style="{StaticResource Glyph}" FontSize="14" Text="&#xE823;" Foreground="{DynamicResource TextSecondary}" Margin="0,1,8,0"/>
            <TextBlock x:Name="StatusText" FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </Border>

        <Button x:Name="DrinkButton" Grid.Row="3" Style="{StaticResource PrimaryButton}" Height="48" Tag="24" Margin="0,0,4,0" Click="DrinkButton_Click" ToolTip="记录一杯 (空格 / 回车)">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="DrinkGlyph" Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="14" Margin="0,1,8,0"/>
            <TextBlock x:Name="DrinkLabel" Text="喝一杯" FontSize="16" VerticalAlignment="Center"/>
            <TextBlock x:Name="DrinkAmount" Text="  370 ml" FontSize="14" FontWeight="Normal" Opacity="0.85" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>

        <Grid Grid.Row="4" Margin="0,8,4,0">
          <UniformGrid x:Name="ActionsRow" Columns="3">
            <Button Style="{StaticResource ActionButton}" Click="CustomButton_Click" ToolTip="记录任意饮水量">
              <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE70F;" HorizontalAlignment="Center"/><TextBlock Text="自定义" Margin="0,4,0,0" HorizontalAlignment="Center"/></StackPanel>
            </Button>
            <Button Style="{StaticResource ActionButton}" Click="RecordsButton_Click" ToolTip="查看和编辑今日记录">
              <StackPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE81C;" HorizontalAlignment="Center"/><TextBlock Text="记录" Margin="0,4,0,0" HorizontalAlignment="Center"/></StackPanel>
            </Button>
            <Button x:Name="PauseButton" Style="{StaticResource ActionButton}" Click="PauseButton_Click">
              <StackPanel><TextBlock x:Name="PauseGlyph" Style="{StaticResource Glyph}" Text="&#xE769;" HorizontalAlignment="Center"/><TextBlock x:Name="PauseLabel" Text="暂停" Margin="0,4,0,0" HorizontalAlignment="Center"/></StackPanel>
            </Button>
          </UniformGrid>
          <!-- Snackbar shown after logging -->
          <Border x:Name="Snackbar" Background="{DynamicResource SuccessSoft}" CornerRadius="8" Padding="12,0,12,0" Opacity="0" IsHitTestVisible="False">
            <Grid HorizontalAlignment="Center">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;" FontSize="14" Foreground="{DynamicResource Success}" Margin="0,1,8,0"/>
              <TextBlock x:Name="SnackText" Grid.Column="1" FontSize="13" Foreground="{DynamicResource Success}" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Grid>
          </Border>
        </Grid>
      </Grid>

      <!-- ===== Compact ===== -->
      <Grid x:Name="CompactPanel" Margin="12" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid Width="52" Height="52">
          <c:ProgressRing x:Name="MiniRing" Thickness="5" TrackBrush="{DynamicResource RingTrack}" FillBrush="{DynamicResource RingFill}"/>
          <TextBlock x:Name="MiniPercent" Text="0%" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Height="24">
            <Border x:Name="MiniAmountHit" Background="Transparent" Cursor="Hand" CornerRadius="4" Padding="2,0" Margin="-2,0,0,0"
                    ToolTip="点击修正今日已喝量" MouseLeftButtonDown="MiniAmount_MouseDown">
              <Border.Style>
                <Style TargetType="Border">
                  <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ControlHover}"/></Trigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <TextBlock x:Name="MiniAmount" Text="0" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Border>
            <TextBox x:Name="MiniEditor" Visibility="Collapsed" Width="64" FontSize="15" FontWeight="SemiBold" MaxLength="6"
                     TextAlignment="Left" VerticalContentAlignment="Center" Padding="0"
                     Background="Transparent" Foreground="{DynamicResource TextPrimary}" CaretBrush="{DynamicResource Accent}"
                     BorderBrush="{DynamicResource Accent}" BorderThickness="0,0,0,2" FocusVisualStyle="{x:Null}"
                     InputMethod.IsInputMethodEnabled="False"
                     PreviewKeyDown="AmountEditor_PreviewKeyDown" LostKeyboardFocus="AmountEditor_LostFocus" TextChanged="AmountEditor_TextChanged">
              <TextBox.Template>
                <ControlTemplate TargetType="TextBox">
                  <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"/>
                  </Border>
                </ControlTemplate>
              </TextBox.Template>
            </TextBox>
            <TextBlock x:Name="MiniGoal" Text=" / 2,000 ml" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
          </StackPanel>
          <TextBlock x:Name="MiniStatus" Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <Button x:Name="MiniDrink" Grid.Column="2" Style="{StaticResource PrimaryButton}" Width="40" Height="40" Tag="20" Padding="0"
                FontFamily="{StaticResource IconFont}" FontSize="16" Content="&#xE710;" Click="DrinkButton_Click" ToolTip="喝一杯"/>
        <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE740;" Margin="4,0,0,0" ToolTip="展开" Click="CompactButton_Click"/>
      </Grid>
    </Grid>
  </Border>
</Window>
