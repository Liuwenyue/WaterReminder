<Window x:Class="WaterReminder.Client.RecordsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource FluentWindow}" Title="饮水记录" Width="760" Height="640" SizeToContent="Manual" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Topmost="True">
  <Window.Resources>
    <DataTemplate x:Key="PickerLabel">
      <TextBlock Text="{Binding Label}" TextWrapping="Wrap" ToolTip="{Binding Label}"/>
    </DataTemplate>
  </Window.Resources>
  <Border Style="{StaticResource WindowCard}">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="24,16,12,8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Image Source="{StaticResource DropImage}" Width="40" Height="40" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
          <TextBlock x:Name="TitleText" Text="今日记录" Style="{StaticResource Title}"/>
          <TextBlock x:Name="SummaryText" Style="{StaticResource Caption}" FontSize="13" Margin="0,2,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <Button Grid.Column="2" Style="{StaticResource CloseButton}" Content="&#xE8BB;" VerticalAlignment="Top" ToolTip="关闭" Click="Close_Click"/>
      </Grid>

      <Grid Grid.Row="1" Margin="16,0,16,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <ScrollViewer x:Name="BodyScroll" Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="8,8,4,0">
        <Border Style="{StaticResource SectionCard}" Padding="16" Margin="0,0,0,12">
          <StackPanel>
            <ComboBox x:Name="HistoryPicker" Style="{StaticResource FluentComboBox}" ItemTemplate="{StaticResource PickerLabel}"
                      TextSearch.TextPath="Label" AutomationProperties.Name="最近 30 天的饮水记录"
                      SelectionChanged="History_Changed" Margin="0,0,0,12" Visibility="Collapsed"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Button x:Name="PrevDayButton" Style="{StaticResource SecondaryButton}" Content="上一天" Padding="8,0" Margin="0,0,8,0" Click="PrevDay_Click"/>
              <TextBlock x:Name="DateLabel" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Margin="8,0" TextWrapping="Wrap" TextAlignment="Center"/>
              <Button x:Name="NextDayButton" Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="下一天" Padding="8,0" Margin="8,0,0,0" Click="NextDay_Click"/>
            </Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
              <ToggleButton x:Name="WeekViewButton" Style="{StaticResource Chip}" Content="周" MinWidth="72" Margin="0,0,12,0" IsChecked="True" Click="WeekView_Click"/>
              <ToggleButton x:Name="MonthViewButton" Style="{StaticResource Chip}" Content="月" MinWidth="72" Click="MonthView_Click"/>
            </StackPanel>
            <TextBlock x:Name="PeriodSummary" Style="{StaticResource Caption}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <UniformGrid x:Name="PeriodGrid" Columns="7" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>

        <Border x:Name="FamilyPanel" Visibility="Collapsed" Style="{StaticResource SectionCard}" Padding="16" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="家庭成员" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
            <ComboBox x:Name="MemberPicker" Style="{StaticResource FluentComboBox}" ItemTemplate="{StaticResource PickerLabel}"
                      TextSearch.TextPath="Label" AutomationProperties.Name="家庭成员" SelectionChanged="Member_Changed"/>
            <UniformGrid Columns="2" Margin="0,12,0,0">
              <Button x:Name="ArchiveMemberButton" Style="{StaticResource DangerGhostButton}" Content="停用" Click="ArchiveMember_Click" Margin="0,0,8,8"/>
              <Button x:Name="MemberSettingsButton" Style="{StaticResource SecondaryButton}" Content="成员设置" IsEnabled="False" Click="MemberSettings_Click" Margin="0,0,0,8"/>
              <Button x:Name="ResetCodeButton" Style="{StaticResource SecondaryButton}" Content="重置访问码" IsEnabled="False" Click="ResetCode_Click" Margin="0,0,8,8"/>
              <Button x:Name="PushTestButton" Style="{StaticResource SecondaryButton}" Content="测试提醒" Click="PushTest_Click" Margin="0,0,0,8"/>
              <Button x:Name="AddMemberButton" Style="{StaticResource SecondaryButton}" Content="添加成员" Click="AddMember_Click" Margin="0,0,8,0"/>
            </UniformGrid>
            <TextBlock x:Name="FamilyProgressText" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0"/>
          </StackPanel>
        </Border>
                </StackPanel>
        </ScrollViewer>
        <Grid Grid.Column="2" MinHeight="120">
      <ListBox x:Name="RecordsList" Style="{StaticResource PlainList}" Margin="16,0,16,8">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid x:Name="row">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource AccentSoft}">
                <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="14" HorizontalAlignment="Center" Foreground="{DynamicResource AccentText}"/>
              </Border>
              <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding AmountDisplay}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
              </StackPanel>
              <StackPanel x:Name="actions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Opacity="0.35"
                          Visibility="{Binding ActionsVisibility}">
                <Button Style="{StaticResource IconButton}" Content="&#xE70F;" ToolTip="修改" Click="Edit_Click" Tag="6"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="删除" Click="Delete_Click" Tag="6"/>
              </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter TargetName="actions" Property="Opacity" Value="1"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                <Setter TargetName="actions" Property="Opacity" Value="1"/>
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
        <Image Source="{StaticResource DropImage}" Width="56" Height="56" Opacity="0.55" RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock x:Name="EmptyTitle" Text="今天还没有喝水记录" Foreground="{DynamicResource TextPrimary}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4"/>
        <TextBlock x:Name="EmptyHint" Text="在主窗口点「喝一杯」就会出现在这里" Style="{StaticResource Caption}" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,16"/>
      </StackPanel>
      </Grid>

      </Grid>
      <Border Grid.Row="2" Background="{DynamicResource SurfaceAlt}" CornerRadius="0,0,12,12" Padding="16,12,24,12" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0">
        <Grid>
          <Button x:Name="ClearButton" Style="{StaticResource DangerGhostButton}" HorizontalAlignment="Left" Click="Clear_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" FontSize="14" Margin="0,1,8,0"/><TextBlock Text="清空今日"/></StackPanel>
          </Button>
          <Button Style="{StaticResource PrimaryButton}" Content="完成" MinWidth="96" HorizontalAlignment="Right" IsDefault="True" IsCancel="True" Click="Close_Click"/>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
