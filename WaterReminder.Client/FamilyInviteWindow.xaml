<Window x:Class="WaterReminder.Client.FamilyInviteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加家庭成员" Width="480" SizeToContent="Height" ShowInTaskbar="False"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterOwner" Style="{StaticResource FluentWindow}">
  <Border Style="{StaticResource WindowCard}">
    <Grid KeyboardNavigation.TabNavigation="Cycle">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="24,16,12,8">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Image Source="{StaticResource DropImage}" Width="40" Height="40" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock Grid.Column="1" Text="添加家庭成员" Style="{StaticResource Title}" Margin="12,0,12,0" VerticalAlignment="Center"/>
        <Button Grid.Column="2" Style="{StaticResource CloseButton}" Content="&#xE8BB;" IsCancel="True" ToolTip="关闭" VerticalAlignment="Top"/>
      </Grid>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,8,24,16" Focusable="False">
        <StackPanel>
          <Border Style="{StaticResource SectionCard}" Padding="16" Margin="0">
            <StackPanel>
              <TextBlock Text="成员名称" FontSize="13" Margin="0,0,0,8"/>
              <TextBox x:Name="MemberName" Style="{StaticResource FluentTextBox}" MaxLength="32" AutomationProperties.Name="成员名称"/>
              <TextBlock Text="成员自己的 PushWard 密钥（可选）" FontSize="13" Margin="0,16,0,8" TextWrapping="Wrap"/>
              <PasswordBox x:Name="PushToken" Style="{StaticResource FluentPasswordBox}" MaxLength="512" AutomationProperties.Name="成员自己的 PushWard 密钥"/>
            </StackPanel>
          </Border>
          <TextBlock x:Name="Feedback" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{DynamicResource TextSecondary}" FontSize="13">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <TextBlock Text="家庭成员访问码" Style="{StaticResource SectionHeader}" Margin="0,16,0,8" Visibility="{Binding Visibility, ElementName=AccessCode}"/>
          <TextBox x:Name="AccessCode" Style="{StaticResource FluentTextBox}" IsReadOnly="True" Visibility="Collapsed" AutomationProperties.Name="家庭成员访问码"/>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="2" Background="{DynamicResource SurfaceAlt}" CornerRadius="0,0,12,12" Padding="24,12" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource SecondaryButton}" IsCancel="True" Content="关闭" MinWidth="80" Margin="0,0,8,0"/>
          <Button x:Name="CreateButton" Style="{StaticResource PrimaryButton}" IsDefault="True" Content="生成访问码" MinWidth="112" Click="Create_Click"/>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
