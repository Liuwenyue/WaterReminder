<Window x:Class="WaterReminder.Client.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:WaterReminder.Controls;assembly=WaterReminder.Shared"
        Style="{StaticResource FluentWindow}" Title="喝水提醒设置" Width="860" Height="800" SizeToContent="Manual" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
  <Border Style="{StaticResource WindowCard}">
    <Grid ClipToBounds="True">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Margin="24,16,12,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Image Source="{StaticResource DropImage}" Width="40" Height="40" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="SettingsTitle" Text="设置" Style="{StaticResource Title}" TextWrapping="Wrap"/>
          <TextBlock x:Name="SettingsSubtitle" Style="{StaticResource Caption}" FontSize="13" Margin="0,2,0,0" Text="保存在服务器上，保存后立即生效" TextWrapping="Wrap"/>
        </StackPanel>
        <Button Grid.Column="2" Style="{StaticResource CloseButton}" Content="&#xE8BB;" VerticalAlignment="Top" ToolTip="关闭" Click="Cancel_Click"/>
      </Grid>

      <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,4,16,12" Focusable="False" CanContentScroll="False">
        <Grid x:Name="SettingsContent">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="饮水目标" Style="{StaticResource SectionHeader}"/>
            <Border Style="{StaticResource SectionCard}" Padding="16,14">
              <StackPanel>
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.6*" MinWidth="188"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="每日目标" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                  <c:Stepper x:Name="GoalStepper" Grid.Column="1" Minimum="100" Maximum="10000" Step="100" Suffix="ml" HorizontalAlignment="Stretch"/>
                </Grid>
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.6*" MinWidth="188"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="工作杯" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                  <c:Stepper x:Name="WorkCupStepper" Grid.Column="1" Minimum="50" Maximum="3000" Step="10" Suffix="ml" HorizontalAlignment="Stretch"/>
                </Grid>
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.6*" MinWidth="188"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="家庭杯" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                  <c:Stepper x:Name="HomeCupStepper" Grid.Column="1" Minimum="50" Maximum="3000" Step="10" Suffix="ml" HorizontalAlignment="Stretch"/>
                </Grid>
                <TextBlock x:Name="GoalError" Style="{StaticResource ErrorText}" Margin="0,8,0,0"/>
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource Glyph}" Text="&#xE946;" FontSize="13" Foreground="{DynamicResource AccentText}" Margin="0,2,8,0" VerticalAlignment="Top"/>
                  <TextBlock x:Name="PlanSummary" Grid.Column="1" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                </Grid>
              </StackPanel>
            </Border>

            <TextBlock Text="手机推送" Style="{StaticResource SectionHeader}"/>
            <Border Style="{StaticResource SectionCard}" Padding="16,14">
              <StackPanel>
                <CheckBox x:Name="MobilePushBox" Style="{StaticResource ToggleSwitch}" Click="MobilePush_Click">
                  <StackPanel>
                    <TextBlock Text="开启手机推送" FontSize="13"/>
                    <TextBlock x:Name="MobilePushHint" Text="由服务器发送。密钥只留在服务器上，这里不能查看或修改。" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                  </StackPanel>
                </CheckBox>
                <StackPanel x:Name="MemberPushTokenPanel" Visibility="Collapsed" Margin="0,12,0,0">
                  <TextBlock Text="更换该成员的 PushWard 密钥" FontSize="13" Margin="0,0,0,8"/>
                  <PasswordBox x:Name="MemberPushToken" Style="{StaticResource FluentPasswordBox}" MaxLength="512" AutomationProperties.Name="该成员的新 PushWard 密钥"/>
                  <TextBlock Text="留空保留现有密钥，不会显示原密钥。" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <TextBlock x:Name="LocalPreferencesHeader" Text="通用" Style="{StaticResource SectionHeader}"/>
            <Border x:Name="LocalPreferencesCard" Style="{StaticResource SectionCard}" Padding="16,8">
              <StackPanel>
                <CheckBox x:Name="FloatingBox" Style="{StaticResource ToggleSwitch}">
                  <StackPanel>
                    <TextBlock Text="显示桌面悬浮窗" FontSize="13"/>
                    <TextBlock Text="关闭后可从系统托盘打开" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                  </StackPanel>
                </CheckBox>
                <CheckBox x:Name="AutoStartBox" Style="{StaticResource ToggleSwitch}" Margin="0,8,0,4">
                  <StackPanel>
                    <TextBlock Text="开机自动启动" FontSize="13"/>
                    <TextBlock Text="登录 Windows 后在后台运行本客户端（只存在本机）" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                  </StackPanel>
                </CheckBox>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Grid.Column="2">
            <TextBlock Text="提醒时间" Style="{StaticResource SectionHeader}"/>
            <Border Style="{StaticResource SectionCard}" Padding="16,14">
              <StackPanel>
                <Grid Margin="0,0,0,12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.6*" MinWidth="188"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="上班时间" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                  <c:Stepper x:Name="StartStepper" Grid.Column="1" IsTime="True" Minimum="0" Maximum="1439" Step="15" HorizontalAlignment="Stretch"/>
                </Grid>
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.6*" MinWidth="188"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="下班时间" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                  <c:Stepper x:Name="EndStepper" Grid.Column="1" IsTime="True" Minimum="0" Maximum="1439" Step="15" HorizontalAlignment="Stretch"/>
                </Grid>
                <TextBlock x:Name="TimeError" Style="{StaticResource ErrorText}" Margin="0,8,0,0"/>
                <Border Height="1" Background="{DynamicResource Stroke}" Margin="0,14,0,12"/>
                <CheckBox x:Name="LunchBox" Style="{StaticResource ToggleSwitch}" Click="Lunch_Click" Margin="0,0,0,8">
                  <StackPanel>
                    <TextBlock Text="午休时段" FontSize="13"/>
                    <TextBlock Text="午休期间不提醒" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
                  </StackPanel>
                </CheckBox>
                <StackPanel x:Name="LunchGrid">
                  <Grid Margin="0,4,0,12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="1.6*" MinWidth="188"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="午休开始" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                    <c:Stepper x:Name="LunchStartStepper" Grid.Column="1" IsTime="True" Minimum="0" Maximum="1439" Step="15" HorizontalAlignment="Stretch"/>
                  </Grid>
                  <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="1.6*" MinWidth="188"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="午休结束" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                    <c:Stepper x:Name="LunchEndStepper" Grid.Column="1" IsTime="True" Minimum="0" Maximum="1439" Step="15" HorizontalAlignment="Stretch"/>
                  </Grid>
                </StackPanel>
                <TextBlock x:Name="LunchError" Style="{StaticResource ErrorText}" Margin="0,8,0,0"/>
                <Grid Margin="0,14,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.6*" MinWidth="188"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="下班前不喝水" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                  <c:Stepper x:Name="NoDrinkStepper" Grid.Column="1" Minimum="0" Maximum="240" Step="5" Suffix="分钟" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="最后一次提醒会尽量远离下班" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <TextBlock x:Name="NoDrinkError" Style="{StaticResource ErrorText}" Margin="0,8,0,0"/>
                <Grid Margin="0,14,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.6*" MinWidth="188"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="最小间隔" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                  <c:Stepper x:Name="GapStepper" Grid.Column="1" Minimum="5" Maximum="180" Step="5" Suffix="分钟" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="两次提醒至少间隔这么久" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <TextBlock x:Name="GapError" Style="{StaticResource ErrorText}" Margin="0,8,0,0"/>
                <Grid Margin="0,14,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.6*" MinWidth="188"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="免打扰开始" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                  <c:Stepper x:Name="QuietStepper" Grid.Column="1" IsTime="True" Minimum="0" Maximum="1439" Step="15" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="此时间之后不再发送提醒" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <TextBlock x:Name="QuietError" Style="{StaticResource ErrorText}" Margin="0,8,0,0"/>
                <TextBlock Text="提醒日期" FontSize="13" Margin="0,16,0,8"/>
                <UniformGrid x:Name="DaysGrid" Columns="7" Margin="0,0,0,2">
                  <ToggleButton x:Name="Mon" Style="{StaticResource Chip}" Content="一" Margin="2" Padding="0" MinWidth="0" HorizontalAlignment="Stretch" Click="Day_Click"/>
                  <ToggleButton x:Name="Tue" Style="{StaticResource Chip}" Content="二" Margin="2" Padding="0" MinWidth="0" HorizontalAlignment="Stretch" Click="Day_Click"/>
                  <ToggleButton x:Name="Wed" Style="{StaticResource Chip}" Content="三" Margin="2" Padding="0" MinWidth="0" HorizontalAlignment="Stretch" Click="Day_Click"/>
                  <ToggleButton x:Name="Thu" Style="{StaticResource Chip}" Content="四" Margin="2" Padding="0" MinWidth="0" HorizontalAlignment="Stretch" Click="Day_Click"/>
                  <ToggleButton x:Name="Fri" Style="{StaticResource Chip}" Content="五" Margin="2" Padding="0" MinWidth="0" HorizontalAlignment="Stretch" Click="Day_Click"/>
                  <ToggleButton x:Name="Sat" Style="{StaticResource Chip}" Content="六" Margin="2" Padding="0" MinWidth="0" HorizontalAlignment="Stretch" Click="Day_Click"/>
                  <ToggleButton x:Name="Sun" Style="{StaticResource Chip}" Content="日" Margin="2" Padding="0" MinWidth="0" HorizontalAlignment="Stretch" Click="Day_Click"/>
                </UniformGrid>
                <TextBlock x:Name="DaysError" Style="{StaticResource ErrorText}" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>

      <Border Grid.Row="2" Background="{DynamicResource SurfaceAlt}" CornerRadius="0,0,12,12" Padding="24,16" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="SaveError" Style="{StaticResource ErrorText}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" Content="取消" MinWidth="96" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
            <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Content="保存" MinWidth="112" IsDefault="True" Click="Save_Click"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
