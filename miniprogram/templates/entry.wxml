<template name="entry">
  <view class="entry">
    <view class="glyph-tile tile-{{entry.glyph}}" aria-hidden="true">
      <image src="/assets/glyphs/{{entry.glyph}}.png" mode="aspectFit" />
    </view>
    <view class="entry-copy">
      <text class="entry-title">{{entry.label}}</text>
      <text class="entry-time numerals">{{entry.time}}</text>
    </view>
    <text class="entry-amount numerals {{entry.negative ? 'negative' : ''}}">{{entry.amount}}<text class="entry-unit">mL</text></text>
    <button wx:if="{{editing}}" class="button link delete" hover-class="press" data-id="{{entry.id}}" bindtap="remove" aria-label="删除 {{entry.time}} 的记录">删除</button>
  </view>
</template>
