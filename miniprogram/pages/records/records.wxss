.today-link { border-radius: 40rpx; padding: 0 22rpx; background: var(--wash); }
.trend { padding: 29rpx 28rpx 22rpx; }
.trend-title { font-size: 32rpx; font-weight: 650; }
.range { font-size: 23rpx; color: var(--muted); }
.reading-label { margin-top: 28rpx; }
.reading-row { flex-wrap: wrap; gap: 4rpx 18rpx; margin-top: 2rpx; margin-bottom: 23rpx; }
.quantity { align-items: baseline; gap: 8rpx; }
.reading { font-size: 74rpx; line-height: 1.15; font-weight: 670; letter-spacing: -3rpx; }
.reading-unit { font-size: 27rpx; font-weight: 550; color: var(--muted); }
.legend { display: flex; gap: 8rpx; align-items: center; font-size: 22rpx; color: var(--muted); }
.legend-line { width: 30rpx; border-top: 2rpx dashed var(--muted); }
.chart { position: relative; padding-top: 4rpx; }
.guides {
  position: absolute; top: 4rpx; bottom: 55rpx; left: 0; right: 0;
  border-bottom: 1rpx solid var(--line);
}
.guides::before { content: ""; position: absolute; top: 50%; left: 0; right: 0; border-top: 1rpx solid var(--line); }
.target-guide { position: absolute; left: 0; right: 0; border-top: 2rpx dashed var(--muted); opacity: .55; }
.columns { display: flex; position: relative; }
.column {
  display: flex; flex: 1; flex-direction: column; align-items: center; overflow: visible;
  border-radius: 12rpx; padding-top: 0;
}
.bar-slot { position: relative; width: 32rpx; height: 137rpx; }
.bar-slot::after { content: ""; position: absolute; bottom: 0; left: 0; width: 100%; border-bottom: 3rpx solid var(--line); }
.bar-fill {
  width: 100%; height: 100%; border-radius: 12rpx 12rpx 0 0; background: #89a8e4;
  transform-origin: bottom; transition: transform var(--flow) var(--ease), background-color var(--fast);
}
.selected .bar-fill { background: var(--button); }
.selected .bar-slot::after { border-color: var(--accent); }
.day-label { height: 55rpx; display: flex; justify-content: center; align-items: flex-end; }
.day-label text {
  display: flex; align-items: center; justify-content: center; min-width: 42rpx; height: 39rpx;
  padding: 0 4rpx; border-radius: 14rpx; color: var(--muted); font-size: 23rpx;
}
.selected .day-label text { color: var(--accent); background: var(--wash); font-weight: 700; }
.day-nav { display: flex; align-items: center; justify-content: space-between; margin: 17rpx 4rpx 0; }
.step { display: flex; align-items: center; justify-content: center; min-width: 44px; color: var(--accent); }
.day-date { font-size: 27rpx; font-weight: 580; }
.details-head { margin-top: 16rpx; }
.empty-state { display: flex; align-items: center; flex-direction: column; padding: 35rpx 12rpx 25rpx; }
.empty-title { margin-top: 15rpx; color: var(--muted); font-size: 27rpx; }
.edit-tools { display: flex; gap: 16rpx; margin-top: 18rpx; }
.edit-action { flex: 1; background: var(--surface); color: var(--accent); border-radius: 21rpx; font-size: 27rpx; }
.edit-action.delete { color: var(--danger); }
.edit-action[disabled] { background: var(--surface); }
