<import src="../../templates/entry.wxml" />
<view class="page" aria-hidden="{{amountOpen}}">
  <view class="page-head">
    <view>
      <text class="eyebrow">{{ledgerName}} · {{monthLabel}}</text>
      <text class="page-title">饮水记录</text>
    </view>
    <button wx:if="{{offset}}" class="button link today-link" hover-class="press" bindtap="showToday">回到今天</button>
  </view>

  <view class="mode-switch">
    <button class="button mode {{viewMode === 'week' ? 'on' : ''}}" data-mode="week" bindtap="setMode">周</button>
    <button class="button mode {{viewMode === 'month' ? 'on' : ''}}" data-mode="month" bindtap="setMode">月</button>
  </view>

  <view class="surface trend arrive">
    <view class="spread">
      <button class="button step" data-dir="-1" hover-class="press" bindtap="shiftPeriod" aria-label="上一个周期"><view class="chevron back"></view></button>
      <text class="trend-title">{{viewMode === 'month' ? monthLabel : '本周'}}</text>
      <button class="button step" data-dir="1" disabled="{{!canShiftNext}}" hover-class="press" bindtap="shiftPeriod" aria-label="下一个周期"><view class="chevron"></view></button>
    </view>
    <text class="caption period-label">{{periodLabel}}</text>
    <text class="caption reading-label">{{relativeLabel}}饮水</text>
    <view class="spread reading-row">
      <view class="quantity numerals"><text class="reading">{{totalText}}</text><text class="reading-unit">mL</text></view>
      <view class="legend"><view class="legend-line"></view><text>目标 {{goalKnown ? goalText + ' mL' : '未记录'}}</text></view>
    </view>
    <view wx:if="{{viewMode !== 'month'}}" class="chart">
      <view class="guides" aria-hidden="true"><view wx:if="{{goalKnown}}" class="target-guide" style="top: {{goalTop}}%;"></view></view>
      <view class="columns">
        <button wx:for="{{bars}}" wx:key="key" class="button column {{item.selected ? 'selected' : ''}} {{item.future ? 'future' : ''}}" hover-class="press"
          disabled="{{item.future || item.tooOld}}" data-offset="{{item.offset}}" bindtap="pickDay" aria-label="{{item.ariaLabel}}">
          <view class="bar-slot"><view class="bar-fill" style="transform: scaleY({{item.fraction}});"></view></view>
          <view class="day-label"><text>{{item.label}}</text></view>
        </button>
      </view>
    </view>
    <view wx:else class="month">
      <view class="dows">
        <text wx:for="{{dowLabels}}" wx:key="*this">{{item}}</text>
      </view>
      <view class="month-grid">
        <button wx:for="{{monthCells}}" wx:key="key" class="button cell {{item.blank ? 'blank' : ''}} {{item.selected ? 'selected' : ''}} {{item.future || item.tooOld ? 'future' : ''}}"
          disabled="{{item.blank || item.future || item.tooOld}}" data-offset="{{item.offset}}" bindtap="pickDay">
          <text class="cell-day">{{item.label}}</text>
          <text class="cell-amount numerals">{{item.amount}}</text>
        </button>
      </view>
    </view>
  </view>

  <view class="day-nav">
    <button class="button step" disabled="{{!canPrev}}" hover-class="press" bindtap="prev" aria-label="前一天"><view class="chevron back"></view></button>
    <text class="day-date">{{dateLabel}}</text>
    <button class="button step" disabled="{{!canNext}}" hover-class="press" bindtap="next" aria-label="后一天"><view class="chevron"></view></button>
  </view>

  <view class="section-head details-head">
    <text class="section-title">饮水明细</text>
    <button class="button link" hover-class="press" bindtap="toggleEdit">{{editing ? '完成' : '编辑'}}</button>
  </view>
  <view class="surface group">
    <view wx:if="{{empty}}" class="empty-state">
      <view class="glyph-tile"><image src="/assets/glyphs/cup.png" aria-hidden="true" /></view>
      <text class="empty-title">这一天还没有记录</text>
      <button wx:if="{{!editing}}" class="button link" hover-class="press" bindtap="emptyAction">{{offset ? '补记当天总量' : '去记一杯'}}</button>
    </view>
    <block wx:for="{{events}}" wx:key="id"><template is="entry" data="{{entry: item, editing: editing}}" /></block>
  </view>
  <view wx:if="{{editing}}" class="edit-tools arrive">
    <button class="button edit-action" hover-class="press" bindtap="adjust">校正总量</button>
    <button class="button edit-action delete" disabled="{{empty}}" hover-class="press" bindtap="clearDay">清空当天</button>
  </view>
</view>
<amount-sheet wx:if="{{amountOpen}}" id="amountSheet" heading="校正当天总量" confirm-text="保存总量"
  action-id="{{actionId}}" context="{{editContext}}" initial-value="{{initialTotal}}" minimum="{{0}}" maximum="{{maximumTotal}}" bind:confirm="saveTotal" bind:close="closeAmount" />
