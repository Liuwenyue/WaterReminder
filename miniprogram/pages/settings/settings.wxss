.goal-card { padding: 27rpx; }
.goal-heading, .goal-control, .cup-control, .form-row, .minute-control, .time-value, .weekdays {
  display: flex; align-items: center;
}
.goal-heading { gap: 13rpx; font-size: 30rpx; font-weight: 620; }
.edit-hint { margin-left: auto; color: var(--muted); font-size: 24rpx; font-weight: 450; }
.goal-symbol { display: flex; align-items: center; justify-content: center; width: 53rpx; height: 53rpx; background: var(--button); border-radius: 17rpx; }
.goal-symbol image { width: 33rpx; height: 33rpx; }
.goal-control { align-items: baseline; gap: 9rpx; margin: 12rpx 0 23rpx; color: var(--accent); }
.goal-input { height: 91rpx; min-height: 44px; max-width: 85%; min-width: 1ch; font-size: 76rpx; font-weight: 670; letter-spacing: -2rpx; }
.goal-unit { color: var(--muted); font-size: 31rpx; }
.cups { display: flex; gap: 17rpx; }
.cup-field { flex: 1; min-width: 0; padding: 16rpx 20rpx 12rpx; border-radius: 22rpx; background: var(--inset); }
.cup-label { display: block; color: var(--muted); font-size: 24rpx; }
.cup-control { gap: 7rpx; }
.cup-control input { flex: 1; min-width: 0; min-height: 44px; color: var(--ink); font-size: 38rpx; font-weight: 630; }
.cup-control text, .minute-control text { color: var(--muted); font-size: 23rpx; }
.form-group { padding: 0 27rpx; overflow: hidden; }
.form-row { min-height: 96rpx; min-height: max(44px, 96rpx); justify-content: space-between; gap: 12rpx; border-bottom: 1rpx solid var(--line); }
.form-row.last { border-bottom: 0; }
.row-name { flex: 1; min-width: 0; font-size: 29rpx; }
.nested .row-name { padding-left: 21rpx; color: var(--muted); font-size: 27rpx; }
.time-value { gap: 15rpx; color: var(--accent); font-size: 29rpx; font-weight: 550; }
.time-value .chevron { width: 10rpx; height: 10rpx; margin-right: 4rpx; color: var(--muted); }
.minute-control { gap: 8rpx; }
.minute-input { width: 94rpx; min-height: 44px; color: var(--accent); text-align: right; font-size: 30rpx; font-weight: 600; }
.days-group { padding: 18rpx 16rpx; }
.weekdays { justify-content: space-between; }
.weekday { flex: 1; display: flex; align-items: center; justify-content: center; }
.weekday text {
  display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx;
  border-radius: 50%; color: var(--muted); background: var(--inset);
  font-size: 26rpx; transition: background-color var(--fast), color var(--fast);
}
.weekday.on text { color: #fff; background: var(--button); }
.schedule-preview { display: block; margin: 15rpx 10rpx 4rpx; font-size: 24rpx; color: var(--muted); }
.save { margin-top: 31rpx; }
.save-note { margin-top: 24rpx; }
.save-note + .save { margin-top: 10rpx; }
.validation { display: block; color: var(--danger); font-size: 26rpx; margin-top: 20rpx; }
.device-note { display: block; margin: 20rpx 9rpx 0; color: var(--muted); font-size: 24rpx; }

.form-row.stack { flex-direction: column; align-items: stretch; justify-content: center; min-height: 128rpx; padding: 14rpx 0 8rpx; }
.connection-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 16rpx; margin-top: 18rpx; }
.field-error { display: block; color: var(--danger); font-size: 24rpx; margin: 5rpx 0 12rpx; }
.ledger-link { margin: 5rpx 0 12rpx; }
.ledger-toggle { display: inline-flex; align-items: center; gap: 17rpx; padding: 0 10rpx; font-size: 25rpx; }
.ledger-toggle .chevron { width: 9rpx; height: 9rpx; }
.ledger-toggle .chevron.expanded { transform: rotate(135deg); }
.invite-card { padding: 22rpx 27rpx; }
.invite-input { width: 100%; min-height: 44px; box-sizing: border-box; padding: 0 16rpx; border-radius: 14rpx; background: var(--inset); font-size: 28rpx; }
.invite-preview { margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx solid var(--line); }
.invite-preview .primary { flex: 1; width: auto; }
.invite-detail, .channel-note { display: block; color: var(--muted); font-size: 24rpx; overflow-wrap: anywhere; }
.invite-detail { margin-top: 8rpx; }
.pair-heading { display: block; font-size: 30rpx; font-weight: 620; }
.pair-code-row { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin: 20rpx 0; padding: 16rpx 20rpx; border-radius: 20rpx; background: var(--inset); }
.pair-code { display: block; color: var(--ink); font-size: 44rpx; font-weight: 670; letter-spacing: 4rpx; }
.pair-code-row .link { padding: 0 14rpx; flex-shrink: 0; }
.pair-primary { margin-top: 20rpx; }
.pair-secondary { display: flex; margin: 4rpx auto 0; }
.owner-status { margin: 14rpx 0; }
