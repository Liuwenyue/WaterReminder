page {
  --page: #f4f6fa;
  --surface: #ffffff;
  --inset: #f0f3f8;
  --ink: #172339;
  --muted: #59677d;
  --line: #e0e5ed;
  --accent: #245bce;
  --button: #255ed3;
  --wash: #e9f0ff;
  --purple-wash: #f1ecfc;
  --mint-wash: #e4f4ee;
  --success: #167455;
  --danger: #b13741;
  --shadow: 0 5rpx 20rpx rgba(37, 55, 88, .055);
  --fast: 140ms;
  --ease: cubic-bezier(.22,.8,.28,1);
  --arrive: 360ms;
  --flow: 580ms;
  background: var(--page);
  color: var(--ink);
  font: 30rpx/1.45 -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}
@media (prefers-color-scheme: dark) {
  page {
    --page: #10141d;
    --surface: #1c2330;
    --inset: #252f3e;
    --ink: #f1f4fb;
    --muted: #a6b3c7;
    --line: #303b4c;
    --accent: #94b9ff;
    --button: #305fc9;
    --wash: #23324e;
    --purple-wash: #302d42;
    --mint-wash: #203b39;
    --success: #8edbb9;
    --danger: #ff9ca5;
    --shadow: none;
  }
}
@media (prefers-reduced-motion: reduce) {
  page { --fast: 0ms; --arrive: 0ms; --flow: 0ms; }
}
.page {
  width: 100%;
  max-width: 570px;
  margin: 0 auto;
  padding: 20rpx 34rpx 48rpx;
  box-sizing: border-box;
}
.page-head, .section-head, .spread, .entry, .quantity, .inline {
  display: flex;
  align-items: center;
}
.page-head, .section-head, .spread { justify-content: space-between; }
.page-head { min-height: 96rpx; margin-bottom: 24rpx; }
.eyebrow, .caption, .entry-time { display: block; color: var(--muted); font-size: 24rpx; }
.eyebrow { margin-bottom: 4rpx; font-weight: 550; }
.page-title, .section-title, .entry-title { display: block; }
.page-title { font-size: 66rpx; font-weight: 730; letter-spacing: -3rpx; line-height: 1.13; }
.section-head { margin: 32rpx 4rpx 12rpx; min-height: 48rpx; }
.section-title { font-size: 36rpx; font-weight: 680; letter-spacing: -1rpx; }
.surface {
  background: var(--surface);
  border-radius: 36rpx;
  box-shadow: var(--shadow);
}
.numerals { font-variant-numeric: tabular-nums; }
.button {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto;
  min-width: 0;
  max-width: none;
  min-height: 44px;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  line-height: 1.3;
  font-size: inherit;
  font-weight: 550;
  text-align: center;
  transition: transform var(--fast) var(--ease), opacity var(--fast);
}
.button::after { border: 0; }
button.button:not([size=mini]) { width: auto; }
button.primary:not([size=mini]) { width: 100%; }
.press { transform: scale(.975); opacity: .82; }
.button[disabled] { opacity: .4; background: transparent; color: var(--muted); }
.link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 6rpx;
  color: var(--accent);
  font-size: 26rpx;
}
.primary {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 52px;
  width: 100%;
  border-radius: 25rpx;
  background: var(--button);
  color: #fff;
  font-size: 31rpx;
  font-weight: 620;
}
.chevron {
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  flex: none;
  border-right: 3rpx solid currentColor;
  border-top: 3rpx solid currentColor;
  transform: rotate(45deg);
}
.chevron.back { transform: rotate(-135deg); }
.glyph-tile {
  width: 76rpx;
  height: 76rpx;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 23rpx;
  background: var(--wash);
}
.glyph-tile image { width: 43rpx; height: 43rpx; }
.tile-bell { background: var(--purple-wash); }
.tile-adjust { background: var(--mint-wash); }
.group { padding: 0 27rpx; }
.entry { min-height: 110rpx; gap: 19rpx; }
.entry + .entry { border-top: 1rpx solid var(--line); }
.entry .glyph-tile { width: 66rpx; height: 66rpx; border-radius: 20rpx; }
.entry .glyph-tile image { width: 38rpx; height: 38rpx; }
.entry-copy { flex: 1; min-width: 0; }
.entry-title { font-size: 29rpx; font-weight: 590; }
.entry-time { margin-top: 2rpx; }
.entry-amount { flex: none; font-size: 32rpx; font-weight: 650; }
.entry-unit { margin-left: 5rpx; color: var(--muted); font-size: 22rpx; font-weight: 500; }
.negative { color: var(--muted); }
.delete { color: var(--danger); }
.arrive { animation: page-arrive var(--arrive) var(--ease) both; }
@keyframes page-arrive {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}
@media (prefers-reduced-motion: reduce) {
  .press { transform: none; }
}
@media (max-width: 345px) {
  .page { padding-right: 22rpx; padding-left: 22rpx; }
}
