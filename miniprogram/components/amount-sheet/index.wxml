<view class="editor">
  <view class="scrim {{closing ? 'scrim-out' : ''}}" catchtap="dismiss" catchtouchmove="blockScroll" aria-hidden="true"></view>
  <view class="dock {{dragging ? 'tracking' : ''}}" style="bottom: {{keyboardHeight}}px; transform: translateY({{dragY}}px);">
    <view class="panel {{closing ? 'panel-out' : ''}} {{keyboardHeight ? 'keyboard-up' : ''}}" aria-role="dialog" aria-modal="true" aria-label="{{heading}}">
      <view class="grip-area" catchtouchstart="startDrag" catchtouchmove="moveDrag" catchtouchend="endDrag" catchtouchcancel="cancelDrag" aria-hidden="true"><view class="grip"></view></view>
      <view class="panel-title">
        <text class="sheet-heading">{{heading}}</text>
        <button class="button link" hover-class="press" bindtap="dismiss">取消</button>
      </view>
      <text wx:if="{{context}}" class="sheet-context">{{context}}</text>
      <view class="amount-field">
        <input class="amount-input numerals" type="number" maxlength="8" value="{{value}}" placeholder="0" placeholder-class="amount-placeholder"
          adjust-position="{{false}}" confirm-type="done" aria-label="水量，单位毫升"
          bindinput="onInput" bindkeyboardheightchange="onKeyboard" bindconfirm="confirm" />
        <text class="amount-unit">mL</text>
      </view>
      <view wx:if="{{presets.length}}" class="presets">
        <button wx:for="{{presets}}" wx:key="*this" class="button preset {{value == item ? 'chosen' : ''}}" hover-class="press"
          data-amount="{{item}}" bindtap="pick" aria-label="填入 {{item}} 毫升">{{item}} mL</button>
      </view>
      <text wx:if="{{error}}" class="field-error" aria-live="polite">{{error}}</text>
      <button class="button primary confirm" hover-class="press" bindtap="confirm">{{confirmText}}</button>
    </view>
  </view>
</view>
