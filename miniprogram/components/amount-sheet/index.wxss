.editor { position: fixed; z-index: 20; top: 0; right: 0; bottom: 0; left: 0; }
.scrim { position: absolute; inset: 0; top: 0; bottom: 0; left: 0; right: 0; background: rgba(10, 19, 39, .44); animation: dim-in var(--fast) ease both; }
.scrim-out { animation: dim-out var(--fast) ease both; }
.dock {
  position: absolute; top: 0; left: 0; right: 0;
  display: flex; align-items: flex-end; justify-content: center;
  pointer-events: none; transition: transform var(--fast) var(--ease);
}
.tracking { transition: none; }
.panel {
  box-sizing: border-box; width: 100%; max-width: 570px; max-height: 100%; overflow-y: auto;
  pointer-events: auto; padding: 0 34rpx 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 46rpx 46rpx 0 0; background: var(--surface); color: var(--ink);
  animation: sheet-in var(--arrive) var(--ease) both;
}
.keyboard-up { padding-bottom: 24rpx; }
.panel-out { animation: sheet-out var(--fast) ease-in both; }
.grip-area { display: flex; align-items: center; justify-content: center; height: 43rpx; touch-action: none; }
.grip { width: 68rpx; height: 8rpx; border-radius: 8rpx; background: var(--line); }
.panel-title, .amount-field, .presets { display: flex; align-items: center; }
.panel-title { justify-content: space-between; margin: 0 1rpx 19rpx; }
.sheet-heading { font-size: 42rpx; font-weight: 680; letter-spacing: -1.5rpx; }
.amount-field { padding: 20rpx 26rpx; border-radius: 25rpx; background: var(--inset); gap: 12rpx; }
.amount-input { flex: 1; min-width: 0; height: 78rpx; color: var(--ink); font-size: 58rpx; font-weight: 640; }
.amount-unit { color: var(--muted); font-size: 31rpx; }
.amount-placeholder { color: var(--muted); }
.presets { gap: 15rpx; margin-top: 18rpx; }
.preset { flex: 1; border-radius: 20rpx; background: var(--inset); color: var(--muted); font-size: 26rpx; }
.chosen { background: var(--wash); color: var(--accent); box-shadow: inset 0 0 0 2rpx var(--accent); }
.confirm { margin-top: 28rpx; }
.field-error { display: block; margin-top: 18rpx; color: var(--danger); font-size: 26rpx; }
@keyframes sheet-in { from { transform: translateY(100%); } to { transform: translateY(0); } }
@keyframes sheet-out { from { transform: translateY(0); } to { transform: translateY(100%); } }
@keyframes dim-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes dim-out { from { opacity: 1; } to { opacity: 0; } }
.sheet-context { display: block; margin: 0 0 12rpx; color: var(--muted); font-size: 24rpx; overflow-wrap: anywhere; }
